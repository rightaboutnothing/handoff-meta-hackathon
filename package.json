{
  "name": "handoff-private-gateway",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": { "handoff": "./bin/handoff.mjs" },
  "engines": { "node": ">=24" },
  "scripts": {
    "handoff": "node bin/handoff.mjs",
    "comparison:dataset": "node scripts/build-comparison-dataset.mjs",
    "comparison:tier0": "node scripts/run-comparison.mjs --tier 0",
    "comparison:cost-audit": "node scripts/revise-tier0-costs.mjs",
    "comparison:stage1": "node scripts/run-stage1.mjs",
    "comparison:stage2": "node scripts/run-stage2.mjs",
    "comparison:stage3": "node scripts/run-stage3.mjs",
    "comparison:stage4": "node scripts/build-stage4-report.mjs",
    "guard:stage5": "node scripts/run-stage5-guard.mjs",
    "guard:stage6:data": "node scripts/fetch-stage6-data.mjs",
    "guard:stage6:prepare-corpus": "node scripts/prepare-stage6-corpus.mjs",
    "guard:stage6:prepare-live": "node scripts/prepare-stage6-live.mjs",
    "guard:stage6": "node scripts/run-stage6-stress.mjs",
    "guard:stage6:report": "node scripts/report-stage6.mjs",
    "comparison:prepare-tokenizers": "node scripts/prepare-tokenizers.mjs",
    "test:comparison": "node --test tests/comparison-*.test.mjs",
    "demo:build": "node scripts/generate-company-demo.mjs",
    "test:rag": "node --test tests/*.test.mjs",
    "test:gateway-rounds": "node scripts/run-gateway-rounds.mjs",
    "dashboard": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build",
    "dashboard:check": "npm --prefix dashboard run check",
    "tasks:build": "node scripts/build-task-suites.mjs && node scripts/generate-ad-privacy.mjs",
    "tasks:fetch-gpqa": "node scripts/fetch-gpqa.mjs",
    "benchmark:dry": "node scripts/run-benchmark.mjs --limit 3",
    "benchmark:full": "node scripts/run-full-benchmark.mjs",
    "benchmark:full:supervised": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-full-benchmark.ps1",
    "benchmark:full:offline-meta": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-full-benchmark.ps1 -OfflineMeta",
    "test:scoring": "node scripts/test-scoring.mjs",
    "test:safety-screen": "node scripts/test-safety-screen.mjs",
    "test:meta-api": "node scripts/test-meta-api.mjs",
    "test:openrouter": "node scripts/test-openrouter.mjs",
    "test:router": "node scripts/test-router-e2e.mjs",
    "test:handoffs": "node scripts/test-handoff-pairings.mjs",
    "test:routing-confidence": "node scripts/test-routing-confidence.mjs"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@huggingface/transformers": "^4.3.2",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "mammoth": "^1.13.0",
    "openai": "^6.0.0",
    "pdf-parse": "^2.4.5",
    "sqlite-vec": "^0.1.9"
  }
}
